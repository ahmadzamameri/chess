# منفذ السيرفر
PORT=4000

# أصل الواجهة المسموح له بالاتصال (CORS). في التطوير هو منفذ Vite
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------
# قاعدة البيانات (MySQL). إن تُركت فارغة يعمل الموقع بوضع الضيوف فقط
# (بلا حسابات/حفظ/لوحة تحكم).
# ---------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chess_app

# ---------------------------------------------------------------------
# سرّ توقيع توكن الدخول (لاعبين ومشرفين). مطلوب لتفعيل الحسابات ولوحة التحكم.
# استخدم قيمة عشوائية طويلة (32 حرفًا فأكثر) على الإنتاج.
# ---------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=30d
# مدة توكن المشرف (أقصر عمدًا)
ADMIN_JWT_EXPIRES_IN=2d

# مفتاح إيقاف لوحة التحكم كليًا. اضبطها false لإخفاء /api/admin (404).
# احذفها أو اجعلها true لتفعيل اللوحة.
ADMIN_PANEL_ENABLED=true
